{
  "name": "agent-ai-intg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Instagram AI content studio for Euro Digital: Claude-generated drafts, human approval, official Meta publishing, durable scheduling.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:https": "next dev -p 3100 --experimental-https",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx --conditions=react-server worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "user:create": "tsx scripts/create-user.ts",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:check": "node scripts/install-skills.mjs --check",
    "ai:ping": "tsx --conditions=react-server scripts/claude-ping.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/s3-request-presigner": "3.1159.0",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.62.0",
    "mysql2": "^3.24.6",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
