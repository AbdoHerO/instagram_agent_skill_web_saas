# agent_ai_intg — configuration (placeholders only; copy to .env.local and fill in).
# Never commit .env.local. In production, set these in the host's secret settings.

# --- Application -----------------------------------------------------------
APP_URL=http://localhost:3100
SESSION_TTL_HOURS=168

# --- Database (MySQL 8; MariaDB 10.4+ works locally) ----------------------
# scripts\setup-database.ps1 creates the database (and a user) and writes this line for you.
DATABASE_URL=mysql://agent_ai:CHANGE_ME@127.0.0.1:3306/agent_ai_intg
# Or, instead of DATABASE_URL (CloudOps writes these): DB_SOCKET or DB_HOST/DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# true: apply pending migrations when the server starts (hosting without a shell)
DB_AUTO_MIGRATE=false
# 32 random bytes, base64. Encrypts Meta tokens at rest. The setup script generates one.
TOKEN_ENCRYPTION_KEY=

# --- Claude (Anthropic API) ------------------------------------------------
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace (the API then answers 400 without it). Not a secret:
# the ID column of Claude Console > Settings > Workspaces, e.g. wrkspc_01...
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
AI_DAILY_GENERATION_LIMIT=50
# Runs the skills' Python tools (python3 on Linux/macOS; on Windows `python3` or `python`).
PYTHON_BIN=python3

# --- Product data (read-only) ----------------------------------------------
# Public API of the existing e-commerce backend, e.g. http://192.168.1.7:8010/api/v1
ECOMMERCE_API_URL=
# Public website address for product links in posts (leave empty until a domain exists)
STOREFRONT_PUBLIC_URL=

# --- Meta: Instagram API with Unified Login ----------------------------------
# Meta app ID and secret (NOT the Instagram app ID/secret).
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration ID (token type: System-user access token). Not a secret.
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
# Always APP_URL + /api/meta/oauth/callback, and exactly the Redirect URL saved in the Unified login
# configuration. Meta requires HTTPS: locally run `npm run dev:https` and use https://localhost:3100 for both.
META_REDIRECT_URI=http://localhost:3100/api/meta/oauth/callback
# disabled (default): the worker never contacts Instagram. live: approved, scheduled posts are published.
PUBLISHING_MODE=disabled

# --- Media storage ------------------------------------------------------------
# local: files in MEDIA_LOCAL_DIR, served at MEDIA_PUBLIC_BASE_URL/media/... (Meta must reach it: public HTTPS)
# s3: an S3-compatible bucket; Meta receives a one-hour pre-signed URL
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=storage/media
MEDIA_PUBLIC_BASE_URL=
# Largest upload: 60 MiB (Server Actions accept 60 MB; the page refuses larger files before sending them)
MEDIA_MAX_BYTES=62914560
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Worker -----------------------------------------------------------------
# Writes AI drafts in the background and handles publishing jobs.
# true: runs inside the web server (one process, e.g. CloudOps); false: run `npm run worker` next to it.
WORKER_IN_PROCESS=true
WORKER_POLL_SECONDS=15
