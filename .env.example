# agent_ai_intg — configuration (placeholders only; copy to .env.local and fill in).
# Never commit .env.local. In production, set these in the host's secret settings.

# --- Application -----------------------------------------------------------
APP_URL=http://localhost:3100
SESSION_TTL_HOURS=168

# --- Database (PostgreSQL) -------------------------------------------------
# scripts\setup-database.ps1 creates the role/database and writes this line for you.
DATABASE_URL=postgres://agent_ai:CHANGE_ME@127.0.0.1:5432/agent_ai_intg
# 32 random bytes, base64. Encrypts Meta tokens at rest. The setup script generates one.
TOKEN_ENCRYPTION_KEY=

# --- Claude (Anthropic API) ------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
AI_DAILY_GENERATION_LIMIT=50
# Runs the skills' Python tools (python3 on Linux/macOS; on Windows `python3` or `python`).
PYTHON_BIN=python3

# --- Product data (read-only) ----------------------------------------------
# Public API of the existing e-commerce backend, e.g. http://192.168.1.7:8010/api/v1
ECOMMERCE_API_URL=
# Public website address for product links in posts (leave empty until a domain exists)
STOREFRONT_PUBLIC_URL=

# --- Meta: Instagram API with Unified Login ----------------------------------
# Meta app ID and secret (NOT the Instagram app ID/secret).
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration ID (token type: System-user access token). Not a secret.
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
# Must match exactly a Valid OAuth Redirect URI in the app (HTTPS outside localhost testing).
META_REDIRECT_URI=http://localhost:3100/api/meta/oauth/callback
# disabled (default): the worker never contacts Instagram. live: approved, scheduled posts are published.
PUBLISHING_MODE=disabled

# --- Media storage ------------------------------------------------------------
# local: files in MEDIA_LOCAL_DIR, served at MEDIA_PUBLIC_BASE_URL/media/... (Meta must reach it: public HTTPS)
# s3: an S3-compatible bucket; Meta receives a one-hour pre-signed URL
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=storage/media
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_BYTES=104857600
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Worker -----------------------------------------------------------------
WORKER_POLL_SECONDS=15
